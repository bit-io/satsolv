;; ── transaction: plan_lines / count_steps ────────────────────────────────
#[test]
fn test_plan_lines_and_counts() is
    let p: int = make_test_pool()
    let plan = lib::transaction::resolve_install(p, ["bar"])
    assert(plan.ok)
    let lines: [string] = lib::transaction::plan_lines(plan)
    assert_eq(array_len(lines), array_len(plan.steps))
    assert_eq(lib::transaction::count_steps(plan, "install"), array_len(plan.steps))
    assert_eq(lib::transaction::count_steps(plan, "erase"), 0)
    lib::pool::destroy(p)
end
