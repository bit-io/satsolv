;; ── pełny scenariusz: repo "z palca" + install job + solve + transakcja ──
#[test]
fn test_full_install_scenario() is
    let p: int = lib::pool::new()
    lib::pool::set_arch(p, "x86_64")

    let system: int = lib::repo::new(p, "system")
    lib::pool::set_installed_repo(p, system)
    lib::repo::finalize(system)

    let available: int = lib::repo::new(p, "available")
    lib::repo::set_priority(available, 10, 0)

    let foo: lib::repo::Pkg = lib::repo::new_pkg("foo", "1.0", "1", "x86_64")
    let mut bar: lib::repo::Pkg = lib::repo::new_pkg("bar", "2.0", "1", "x86_64")
    bar.requires = ["foo"]

    let res7 = lib::repo::add_packages(p, available, [foo, bar])
    if !lib::result::is_ok(res7) is
        let msg: string = lib::result::error_message(res7)
        assert(false)
    end
    lib::repo::finalize(available)

    lib::pool::create_whatprovides(p)

    let jobs: int = lib::queue::new()
    lib::job::install_name(jobs, p, "bar")

    let s: int = lib::solver::new(p)
    lib::solver::allow_downgrade(s, false)
    let problems: i32 = lib::solver::run(s, jobs)
    assert_eq(problems, 0)

    let t: int = lib::transaction::create_from_solver(s)
    let installed: [i32] = lib::transaction::installed_result(t)
    ;; "foo" i "bar" powinny obie trafić na listę do instalacji
    assert(array_len(installed) >= 2)

    ;; classify() powinno zwrócić przynajmniej jedną klasę kroków
    ;; (rekordy po 4 pola: type_id/count/from_id/to_id, patrz mod transaction)
    let classes = lib::transaction::classify_active(t)
    assert(array_len(classes) >= 1)

    lib::transaction::destroy(t)
    lib::queue::destroy(jobs)
    lib::solver::destroy(s)
    lib::repo::destroy(available, false)
    lib::repo::destroy(system, false)
    lib::pool::destroy(p)
end

;; ── result: odczyt SatResult bez match ───────────────────────────────────
#[test]
fn test_result_helpers() is
    let p: int = lib::pool::new()
    let q: int = lib::queue::new()
    let ok = lib::job::install_name_version(q, p, "foo", ">=", "1.0")
    assert(lib::result::is_ok(ok))
    assert_eq(lib::result::error_message(ok), "")

    let bad = lib::job::install_name_version(q, p, "foo", "~=", "1.0")
    assert(!lib::result::is_ok(bad))
    assert(lib::result::error_message(bad) != "")
    assert_eq(lib::result::value(bad), -1)

    lib::queue::destroy(q)
    lib::pool::destroy(p)
end

