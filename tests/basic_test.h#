;; ── repo::write_solv_file / add_solv_file: round-trip ────────────────────
#[test]
fn test_solv_file_roundtrip() is
    let p: int = make_test_pool()
    let r: int = lib::repo::new(p, "copy-source")
    let pk: lib::repo::Pkg = lib::repo::new_pkg("baz", "0.1", "1", "x86_64")
    let res = lib::repo::add_packages(p, r, [pk])
    assert(lib::result::is_ok(res))
    lib::repo::finalize(r)

    let path: string = "/tmp/satsolv_roundtrip_test.solv"
    let w = lib::repo::write_solv_file(p, r, path)
    assert(lib::result::is_ok(w))

    let p2: int = lib::pool::new()
    let r2: int = lib::repo::new(p2, "loaded")
    let l = lib::repo::add_solv_file(p2, r2, path)
    assert(lib::result::is_ok(l))

    lib::pool::destroy(p2)
    lib::pool::destroy(p)
end

