pub const REINSTALLED:     i32 = 0x11
pub const DOWNGRADED:      i32 = 0x12
pub const CHANGED:         i32 = 0x13
pub const UPGRADED:        i32 = 0x14
pub const OBSOLETED:       i32 = 0x15

;; strona "nowy/wchodzący pakiet" — skąd się bierze
pub const TRANS_INSTALL:         i32 = 0x20
pub const REINSTALL:       i32 = 0x21
pub const DOWNGRADE:       i32 = 0x22
pub const CHANGE:          i32 = 0x23
pub const UPGRADE:         i32 = 0x24
pub const OBSOLETES:       i32 = 0x25

pub const MULTIINSTALL:    i32 = 0x30
