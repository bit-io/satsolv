pub fn create_from_solver(s: int) -> int is
    return solver_create_transaction(s)
end

pub fn destroy(t: int) is
    transaction_free(t)
end

;; Zwraca typ kroku transakcji (jedna ze stałych wyżej) dla danego Id
;; solvable'a (Id-y bierzesz np. z installed_result()).
pub fn type_of(t: int, solvable_id: i32, mode: i32) -> i32 is
    return transaction_type(t, solvable_id, mode)
end

;; -- transaction_classify: "posortowany zestaw klas kroków" --
;;
;; WAŻNE: `transaction_classify` NIE zwraca płaskiej listy Id
;; solvable'i. Zwraca kolejkę wypełnioną CZWÓRKAMI Id
;; (type, count, from_id, to_id) — po jednej czwórce na każdą klasę
;; kroków obecną w transakcji (potwierdzone wobec SWIG-owych bindingów
;; libsolv, plik bindings/solv.i: `Queue2Array(TransactionClass*, 4, ...)`
;; z polami (type, count, fromid, toid)). Poprzednia wersja tego pliku
;; traktowała tę kolejkę jak zwykłą tablicę Id solvable'i przez
;; `queue::to_array` — to było mylące i błędne. Poniżej dekodujemy
;; czwórki poprawnie na `TransactionClass`.
;;
;; Znaczenie `from_id`/`to_id` zależy od `type_id` — użyj ich razem z
;; classify_step_pkgs() żeby dostać faktyczne Id pakietów danej klasy.
pub struct TransactionClass is
    pub type_id: i32   ;; jedna ze stałych IGNORE/TRANS_ERASE/TRANS_INSTALL/UPGRADE/...
    pub count:   i32   ;; ile kroków transakcji należy do tej klasy
    pub from_id: i32
    pub to_id:   i32
end

pub fn classify_steps(t: int, mode: i32) -> [TransactionClass] is
    let q: int = queue::new()
    transaction_classify(t, mode, q)
    let raw: [i32] = queue::to_array(q)
    queue::destroy(q)

    let mut out: [TransactionClass] = []
    let n: int = array_len(raw)
    let mut i: int = 0
    while i + 3 < n is
        out = array_push(out, TransactionClass {
            type_id: raw[i], count: raw[i + 1], from_id: raw[i + 2], to_id: raw[i + 3]
        })
        i += 4
    end
    return out
end

;; Skrót: classify_steps() z domyślnym trybem MODE_SHOW_ACTIVE.
pub fn classify_active(t: int) -> [TransactionClass] is
    return classify_steps(t, MODE_SHOW_ACTIVE)
end

;; W przeciwieństwie do classify_steps(), TO zwraca płaską listę Id
;; solvable'i — konkretne pakiety należące do jednej klasy zwróconej
;; wcześniej przez classify_steps() (przekaż jej type_id/from_id/to_id).
pub fn classify_step_pkgs(t: int, mode: i32, class: TransactionClass) -> [i32] is
    let q: int = queue::new()
    transaction_classify_pkgs(t, mode, class.type_id, class.from_id, class.to_id, q)
    let out: [i32] = queue::to_array(q)
    queue::destroy(q)
    return out
end

;; Pełna lista Id-ów solvable'i po transakcji (stan końcowy "installed")
;; jako zwykła tablica H#.
pub fn installed_result(t: int) -> [i32] is
    let q: int = queue::new()
    transaction_installedresult(t, q)
    let out: [i32] = queue::to_array(q)
    queue::destroy(q)
    return out
end
;; Czytelna nazwa typu kroku (stale TRANS_* / ERASE... wyzej) — zeby kod
;; zewnetrzny nie musial porownywac z stalymi modulu.
pub fn type_name(type_id: i32) -> string is
    if type_id == TRANS_INSTALL   is return "install" end
    if type_id == TRANS_ERASE     is return "erase" end
    if type_id == UPGRADE         is return "upgrade" end
    if type_id == UPGRADED        is return "upgraded" end
    if type_id == DOWNGRADE       is return "downgrade" end
    if type_id == DOWNGRADED      is return "downgraded" end
    if type_id == REINSTALL       is return "reinstall" end
    if type_id == REINSTALLED     is return "reinstalled" end
    if type_id == CHANGE          is return "change" end
    if type_id == CHANGED         is return "changed" end
    if type_id == OBSOLETES       is return "obsoletes" end
    if type_id == OBSOLETED       is return "obsoleted" end
    if type_id == MULTIINSTALL    is return "multiinstall" end
    if type_id == MULTIREINSTALL  is return "multireinstall" end
    return "other"
end

;; Jeden krok planu: co sie dzieje z jakim pakietem.
pub struct PlanStep is
    pub type_id:   i32
    pub type_name: string
    pub solvable:  i32
    pub text:      string   ;; "nazwa-wersja-release.arch"
end

;; Wynik rozwiazania: ok=false => `problems` opisuje konflikty.
pub struct Plan is
    pub ok:       bool
    pub problems: [string]
    pub steps:    [PlanStep]
end

;; Zamienia udane solve() na liste krokow (install/erase/upgrade/...).
pub fn build_plan(p: int, s: int) -> Plan is
    let t: int = create_from_solver(s)
    let mut steps: [PlanStep] = []
    for cls in classify_active(t) is
        for sid in classify_step_pkgs(t, MODE_SHOW_ACTIVE, cls) is
            steps = array_push(steps, PlanStep {
                type_id: cls.type_id,
                type_name: type_name(cls.type_id),
                solvable: sid,
                text: pool::solvable_to_str(p, sid)
            })
        end
    end
    destroy(t)
    return Plan { ok: true, problems: [], steps: steps }
end

;; Najkrotsza droga: "zainstaluj te pakiety" -> gotowy Plan. Pool musi miec
;; juz zaladowane repo (po repo::finalize). Sprzata po sobie.
pub fn resolve_install(p: int, names: [string]) -> Plan is
    pool::create_whatprovides(p)
    let jobs: int = queue::new()
    for n in names is
        job::install_name(jobs, p, n)
    end
    let s: int = solver::new(p)
    let nprob: i32 = solver::run(s, jobs)
    let mut plan: Plan = Plan { ok: false, problems: [], steps: [] }
    if nprob > 0 is
        plan = Plan { ok: false, problems: solver::all_problems_as_strings(s), steps: [] }
    else is
        plan = build_plan(p, s)
    end
    queue::destroy(jobs)
    solver::destroy(s)
    return plan
end

;; Plan jako czytelne linie: "install foo-1.0-1.x86_64".
pub fn plan_lines(plan: Plan) -> [string] is
    let mut out: [string] = []
    for step in plan.steps is
        out = array_push(out, step.type_name + " " + step.text)
    end
    return out
end

;; Ile krokow danego rodzaju (np. "install", "erase", "upgrade") ma plan.
pub fn count_steps(plan: Plan, kind: string) -> i32 is
    let mut n: i32 = 0
    for step in plan.steps is
        if step.type_name == kind is
            n += 1
        end
    end
    return n
end
