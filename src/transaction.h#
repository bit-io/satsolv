pub const MODE_SHOW_ACTIVE:            i32 = 1 << 0
pub const MODE_SHOW_ALL:               i32 = 1 << 1
pub const MODE_SHOW_OBSOLETES:         i32 = 1 << 2
pub const MODE_SHOW_MULTIINSTALL:      i32 = 1 << 3
