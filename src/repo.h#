pub fn new(p: int, name: string) -> int is
    return repo_create(p, name)
end

;; reuseids: zwykle false, chyba że repo jest usuwane i odtwarzane
;; w pętli i zależy Ci na ponownym użyciu zwolnionych Id.
pub fn destroy(r: int, reuseids: bool) is
    let f: i32 = if reuseids then 1 else 0
    repo_free(r, f)
end

;; Wywołaj po dodaniu wszystkich pakietów do repo.
pub fn finalize(r: int) is
    repo_internalize(r)
end

;; Priorytet repo (wyżej = ważniejsze przy wyborze pakietu spośród
;; kilku repo dostarczających to samo). `subpriority` służy tylko do
;; sortowania (nie do przycinania kandydatów) — zwykle 0.
;;
;; UWAGA: to, podobnie jak `mod queue`, czyta/pisze bezpośrednio pola
;; prawdziwej struktury C `Repo` (src/repo.h) pod stałym offsetem —
;; `priority` leży na offsecie 48, `subpriority` na offsecie 52 (obie
;; to zwykłe 4-bajtowe `int`, layout: name:ptr@0, repoid:i32@8,
;; appdata:ptr@16, pool:ptr@24, start/end/nsolvables/disabled:i32@32..47,
;; priority:i32@48, subpriority:i32@52 — pola te są publiczne w ABI
;; libsolv, poza `#ifdef LIBSOLV_INTERNAL`, więc są stabilne). Ten sam
;; zestaw zastrzeżeń co dla `queue` (LP64-only) obowiązuje tutaj — stąd
;; ta sama samotestowa asercja przed dotknięciem pamięci.
pub fn set_priority(r: int, priority: i32, subpriority: i32) is
    let probe: int = queue::new()
    queue::destroy(probe)
    unsafe is
        ptr_write_i32(r, 48, priority)
        ptr_write_i32(r, 52, subpriority)
    end
end

pub fn get_priority(r: int) -> i32 is
    let probe: int = queue::new()
    queue::destroy(probe)
    let mut v: i32 = 0
    unsafe is
        v = ptr_read_i32(r, 48)
    end
    return v
end

;; Wczytuje binarny plik .solv (format natywny libsolv, produkowany
;; np. przez rpmmd2solv/susetags2solv) — najbardziej "produkcyjna"
;; droga zasilenia repo prawdziwymi metadanymi pakietów.
;; `p` (Pool) jest potrzebny tylko do odczytania pool::error_string() przy
;; błędzie — sam plik ląduje w `r` (Repo).
pub fn add_solv_file(p: int, r: int, path: string) -> SatResult<i32> is
    let fp: int = fopen(path, "r")
    if fp == 0 is
        return SatResult::Err("nie mozna otworzyc pliku: " + path)
    end
    let rc: i32 = repo_add_solv(r, fp, 0)
    fclose(fp)
    if rc != 0 is
        return SatResult::Err("repo_add_solv nie powiodlo sie: " + pool::error_string(p))
    end
    return SatResult::Ok(rc)
end

