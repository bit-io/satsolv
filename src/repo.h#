;; --- opis pakietu do budowania repo "z palca" (bez pliku .solv) ---
pub struct Pkg is
    pub name:       string
    pub version:    string
    pub release:    string  ;; np. "1" jeśli nie masz osobnego release
    pub arch:       string  ;; np. "x86_64" albo "noarch"
    pub requires:    [string]
    pub provides:    [string]
    pub conflicts:   [string]
    pub obsoletes:   [string]
    pub recommends:  [string]
    pub suggests:    [string]
end

pub fn new_pkg(name: string, version: string, release: string, arch: string) -> Pkg is
    return Pkg {
        name: name, version: version, release: release, arch: arch,
        requires: [], provides: [], conflicts: [],
        obsoletes: [], recommends: [], suggests: []
    }
end

;; --- walidacja/escaping wejścia przed sklejeniem tekstu "testtags" ---
;;
;; Format testtags jest rozdzielany liniami: linia zaczyna się od
;; "#>=Tag: " i trwa do końca linii. Jedyny sposób, żeby wartość pola
;; "uciekła" poza swój tag i stała się osobną (dowolną!) linią
;; "#>=...", to wstrzyknięcie znaku nowej linii (`\n`/`\r`) w wartość —
;; np. `name = "foo\n#>=Pkg: zly-pakiet 1 1 x86_64"` bez walidacji
;; wygenerowałoby DWA pakiety zamiast jednego. Dlatego każde pole
;; przechodzi przez `is_clean_line` (zakaz \n/\r) przed sklejeniem, a
;; pola name/version/release/arch (rozdzielane spacją w jednej linii
;; "#>=Pkg: name version release arch") dodatkowo przez `is_clean_token`
;; (zakaz białych znaków w ogóle, bo spacja przesunęłaby kolejne pola).

fn contains_char(s: string, ch: string) -> bool is
    return string_find(s, ch) >= 0
end

fn is_clean_line(s: string) -> bool is
    return !contains_char(s, "\n") && !contains_char(s, "\r")
end

fn is_clean_token(s: string) -> bool is
    if !is_clean_line(s)        is return false end
    if contains_char(s, " ")    is return false end
    if contains_char(s, "\t")   is return false end
    if s == ""                  is return false end
    return true
end

fn check_dep_list(field_name: string, pkg_name: string, deps: [string]) -> string is
    for d in deps is
        if !is_clean_line(d) is
            return "niedozwolony znak nowej linii w polu " + field_name +
                   " pakietu '" + pkg_name + "': '" + d + "'"
        end
    end
    return ""
end

;; Zwraca "" gdy pakiet jest bezpieczny do wstrzyknięcia w tekst
;; testtags, w przeciwnym razie opis błędu.
fn validate_pkg(p: Pkg) -> string is
    if !is_clean_token(p.name) is
        return "nieprawidlowa nazwa pakietu: '" + p.name + "' (wymagany pojedynczy token, bez spacji/nowej linii)"
    end
    if !is_clean_token(p.version) is
        return "nieprawidlowa wersja pakietu '" + p.name + "': '" + p.version + "'"
    end
    if !is_clean_token(p.release) is
        return "nieprawidlowy release pakietu '" + p.name + "': '" + p.release + "'"
    end
    if !is_clean_token(p.arch) is
        return "nieprawidlowa architektura pakietu '" + p.name + "': '" + p.arch + "'"
    end
    let mut err: string = ""
    err = check_dep_list("Requires", p.name, p.requires)
    if err != "" is return err end
    err = check_dep_list("Provides", p.name, p.provides)
    if err != "" is return err end
    err = check_dep_list("Conflicts", p.name, p.conflicts)
    if err != "" is return err end
    err = check_dep_list("Obsoletes", p.name, p.obsoletes)
    if err != "" is return err end
    err = check_dep_list("Recommends", p.name, p.recommends)
    if err != "" is return err end
    err = check_dep_list("Suggests", p.name, p.suggests)
    if err != "" is return err end
    return ""
end

fn tag_lines(tag: string, deps: [string]) -> string is
    let mut out: string = ""
    for d in deps is
        out = out + "#>=" + tag + ": " + d + "\n"
    end
    return out
end

fn pkg_to_testtags(p: Pkg) -> string is
    let mut out: string = "#>=Pkg: " + p.name + " " + p.version + " " +
                           p.release + " " + p.arch + "\n"
    out = out + tag_lines("Req", p.requires)
    out = out + tag_lines("Prv", p.provides)
    out = out + tag_lines("Con", p.conflicts)
    out = out + tag_lines("Obs", p.obsoletes)
    out = out + tag_lines("Rec", p.recommends)
    out = out + tag_lines("Sug", p.suggests)
    return out
end

;; Dodaje listę pakietów do repo przez oficjalny parser libsolvext
;; formatu "testtags" (`testcase_add_testtags`) — bez dotykania
;; wewnętrznego layoutu struct Solvable. Każdy pakiet jest najpierw
;; zwalidowany (patrz `validate_pkg` wyżej) — przy pierwszym
;; niebezpiecznym polu funkcja zwraca błąd i NIC nie zapisuje.
;; `p` (Pool) jest potrzebny tylko do pool::error_string() przy błędzie.
pub fn add_packages(p: int, r: int, pkgs: [Pkg]) -> SatResult<i32> is
    for pk in pkgs is
        let err: string = validate_pkg(pk)
        if err != "" is
            return SatResult::Err(err)
        end
    end

    let mut text: string = ""
    for pk in pkgs is
        text = text + pkg_to_testtags(pk)
    end

    let fp: int = tmpfile()
    if fp == 0 is
        return SatResult::Err("nie udalo sie utworzyc pliku tymczasowego (tmpfile)")
    end
    fputs(text, fp)
    rewind(fp)
    let rc: i32 = testcase_add_testtags(r, fp, 0)
    fclose(fp)

    if rc != 0 is
        return SatResult::Err("testcase_add_testtags nie powiodlo sie: " + pool::error_string(p))
    end
    return SatResult::Ok(rc)
end
