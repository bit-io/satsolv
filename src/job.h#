end

;; Parsuje operator relacji wersji na flagi REL_* (src/pool.h).
;; Wspierane: "=", "==", ">", "<", ">=", "<=", "!=".
fn parse_rel_op(op: string) -> SatResult<i32> is
    if op == "=" || op == "==" is return SatResult::Ok(REL_EQ) end
    if op == ">"               is return SatResult::Ok(REL_GT) end
    if op == "<"               is return SatResult::Ok(REL_LT) end
    if op == ">="              is return SatResult::Ok(REL_GT | REL_EQ) end
    if op == "<="              is return SatResult::Ok(REL_LT | REL_EQ) end
    if op == "!="              is return SatResult::Ok(REL_GT | REL_LT) end
    return SatResult::Err("nieznany operator porownania wersji: '" + op +
                           "' (oczekiwano =, ==, >, <, >=, <=, !=)")
end

;; Wersjonowany odpowiednik install_name(), np.
;; `job::install_name_version(q, p, "foo", ">=", "1.2")` == "foo >= 1.2".
;; Zwraca Id relacji (przydatne do debugowania przez pool::job_to_str)
;; albo błąd, jeśli `op` nie jest rozpoznanym operatorem.
pub fn install_name_version(q: int, p: int, name: string, op: string, version: string) -> SatResult<i32> is
    match parse_rel_op(op) is
        SatResult::Err(msg) => is
            return SatResult::Err(msg)
        end
        SatResult::Ok(flags) => is
            let name_id: i32 = pool::str_to_id(p, name, true)
            let evr_id:  i32 = pool::str_to_id(p, version, true)
            let rel_id:  i32 = pool::rel_to_id(p, name_id, evr_id, flags)
            queue::push2(q, SOLVABLE_NAME | JOB_INSTALL, rel_id)
            return SatResult::Ok(rel_id)
        end
    end
end

pub fn erase_name_version(q: int, p: int, name: string, op: string, version: string) -> SatResult<i32> is
    match parse_rel_op(op) is
        SatResult::Err(msg) => is
            return SatResult::Err(msg)
        end
        SatResult::Ok(flags) => is
            let name_id: i32 = pool::str_to_id(p, name, true)
            let evr_id:  i32 = pool::str_to_id(p, version, true)
            let rel_id:  i32 = pool::rel_to_id(p, name_id, evr_id, flags)
            queue::push2(q, SOLVABLE_NAME | JOB_ERASE, rel_id)
            return SatResult::Ok(rel_id)
        end
    end
end

;; Dokleja do `q` joby `action` (JOB_INSTALL/JOB_ERASE/UPDATE) dla
;; wszystkiego, co pasuje do wzorca `pattern` wg flag SELECTION_*.
;; Zwraca liczbe dolozonych jobow (0 = nic nie pasuje).
pub fn push_selection(q: int, p: int, pattern: string, sel_flags: i32, action: i32) -> i32 is
    let sel: int = queue::new()
    let rc: i32 = selection_make(p, sel, pattern, sel_flags)
    let cnt: i32 = queue::count(sel)
    let mut i: i32 = 0
    while i + 1 < cnt is
        queue::push2(q, queue::get(sel, i) | action, queue::get(sel, i + 1))
        i += 2
    end
    queue::destroy(sel)
    return cnt / 2
end

;; "lib*" -> zainstaluj wszystko o nazwie pasujacej do globa.
pub fn install_glob(q: int, p: int, pattern: string) -> i32 is
    return push_selection(q, p, pattern, SELECTION_NAME | SELECTION_GLOB, JOB_INSTALL)
end

pub fn erase_glob(q: int, p: int, pattern: string) -> i32 is
    return push_selection(q, p, pattern, SELECTION_NAME | SELECTION_GLOB, JOB_ERASE)
end

pub fn update_glob(q: int, p: int, pattern: string) -> i32 is
    return push_selection(q, p, pattern, SELECTION_NAME | SELECTION_GLOB, UPDATE)
end

