    queue::push2(q, SOLVABLE_ALL | VERIFY, 0)
end

pub fn distupgrade_all(q: int) is
    queue::push2(q, SOLVABLE_ALL | DISTUPGRADE, 0)
end

pub fn update_all(q: int) is
    queue::push2(q, SOLVABLE_ALL | UPDATE, 0)
end

;; Instaluj kazdy pakiet z listy (po nazwie).
pub fn install_names(q: int, p: int, names: [string]) is
    for n in names is
        install_name(q, p, n)
    end
end

;; Usun kazdy pakiet z listy (po nazwie).
pub fn erase_names(q: int, p: int, names: [string]) is
    for n in names is
        erase_name(q, p, n)
    end
end

;; Zaktualizuj kazdy pakiet z listy (po nazwie).
pub fn update_names(q: int, p: int, names: [string]) is
    for n in names is
        update_name(q, p, n)
    end
end
