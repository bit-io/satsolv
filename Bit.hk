[package]
-> name        => satsolv
-> version     => 0.2.1
-> description => Bindingi H# do libsolv (SAT solver zaleznosci pakietow) - 100% H#, extern static
-> authors     => ["Bit Developers"]
-> license     => MIT
-> lang        => h#

[edition]
-> edition => 2026

[layout]
-> src => src

[build]
-> link => static

[lib]
-> output => hlib

[pack]
-> contents    => [hlib, a, sources, docs]
-> compression => zstd

[dependencies]

[system-dependencies]
-> libsolv
--> pkg-config => libsolv
--> header => solv/pool.h
--> lib => solv
--> apt => libsolv-dev
--> dnf => libsolv-devel
--> pacman => libsolv
--> apk => libsolv-dev
--> zypper => libsolv-devel
--> brew => libsolv
-> libsolvext
--> pkg-config => libsolvext
--> header => solv/repo_rpmmd.h
--> lib => solvext
--> apt => libsolvext-dev
--> dnf => libsolv-devel
--> pacman => libsolv
--> apk => libsolv-dev
--> zypper => libsolv-devel
--> brew => libsolv
