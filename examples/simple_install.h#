mod lib

fn main() is
    let p: int = lib::pool::new()
    lib::pool::set_arch(p, "x86_64")

    let system: int = lib::repo::new(p, "system")
    lib::pool::set_installed_repo(p, system)
    lib::repo::finalize(system)

    let available: int = lib::repo::new(p, "available")
    lib::repo::set_priority(available, 10, 0)

    let foo: lib::repo::Pkg = lib::repo::new_pkg("foo", "1.0", "1", "x86_64")
    let mut bar: lib::repo::Pkg = lib::repo::new_pkg("bar", "2.0", "1", "x86_64")
    bar.requires = ["foo"]

    let res1 = lib::repo::add_packages(p, available, [foo, bar])
    if !lib::result::is_ok(res1) is
        let msg: string = lib::result::error_message(res1)
        write("Blad wczytywania pakietow: " + msg)
        return
    end
    lib::repo::finalize(available)

    lib::pool::create_whatprovides(p)

    let jobs: int = lib::queue::new()
    let res2 = lib::job::install_name_version(jobs, p, "bar", ">=", "1.5")
    if !lib::result::is_ok(res2) is
        let msg: string = lib::result::error_message(res2)
        write("Blad joba: " + msg)
        return
    end

    let s: int = lib::solver::new(p)
    ;; przykladowa konfiguracja solvera
    lib::solver::allow_downgrade(s, false)
    lib::solver::best_obey_policy(s, true)

    let problems: i32 = lib::solver::run(s, jobs)

    if problems > 0 is
        write("Solver zglosil problemy:")
        for msg in lib::solver::all_problems_as_strings(s) is
            write("  - " + msg)
        end
    else is
        write("Pakiety do zainstalowania:")
        let t: int = lib::transaction::create_from_solver(s)
        for sid in lib::transaction::installed_result(t) is
            write("  - " + lib::pool::solvable_to_str(p, sid))
        end

        write("Podsumowanie klas transakcji:")
        for cls in lib::transaction::classify_active(t) is
            write("  typ=" + lib::transaction::type_name(cls.type_id))
        end

        lib::transaction::destroy(t)
    end

    lib::queue::destroy(jobs)
    lib::solver::destroy(s)
    lib::repo::destroy(available, false)
    lib::repo::destroy(system, false)
    lib::pool::destroy(p)
end
